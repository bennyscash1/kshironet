# App queries (transaction pooler)
DATABASE_URL="postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-eu-west-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Migrations (session pooler)
DIRECT_URL="postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-eu-west-1.pooler.supabase.com:5432/postgres"

# Supabase Auth (public URL + anon key — NOT the DATABASE_URL)
# From Supabase dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL="https://lwhxfjdwbwfxdnpilgeo.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"

# Supabase Storage (server-only — certification file attachments).
# From Supabase dashboard → Project Settings → API Keys → service_role (or a
# `sb_secret_…` key). This file is COMMITTED — keep the real value in .env.local only.
# Never expose this to the browser: it is only read by lib/storage/* on the server,
# where every file operation is already gated by canEdit()/requireEditor().
SUPABASE_SERVICE_ROLE_KEY="YOUR_SUPABASE_SERVICE_ROLE_KEY"
